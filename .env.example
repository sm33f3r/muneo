# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# This file (.env.example) is safe to commit; .env is listed in .gitignore.

COINGECKO_API_KEY=your_coingecko_api_key_here
CMC_API_KEY=your_coinmarketcap_api_key_here
FRED_API_KEY=your_fred_api_key_here
# Also powers the computed ICE DXY (6 FX_DAILY calls/run, on top of the 1 SPY call) —
# free-tier 25 req/day quota covers both.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=owner/repository-name
GITHUB_BRANCH=main
FINNHUB_API_KEY=your_finnhub_api_key_here
SOSOVALUE_API_KEY=       # BTC ETF daily flow data — free at sosovalue.com/developer
