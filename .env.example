# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a free CoinMarketCap API key at:
#   https://coinmarketcap.com/api/
#
# The free Basic plan is sufficient — market_report.py uses:
#   - /v1/cryptocurrency/quotes/latest
#   - /v1/cryptocurrency/ohlcv/historical
#   - /v3/fear-and-greed/historical
#
# IMPORTANT: Never commit .env to version control.
# This file (.env.example) is safe to commit; .env is listed in .gitignore.

CMC_API_KEY=your_api_key_here
